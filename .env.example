# Jarvis AI Assistant Platform - Environment Variables

# Backend
BACKEND_PORT=8000
FRONTEND_PORT=3000
CONFIG_PATH=/app/config/config.docker.yaml

# Database (default: SQLite, set for PostgreSQL)
# DATABASE_URL=postgresql://jarvis:jarvis@postgres:5432/jarvis

# LLM API Keys (set the ones you need)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Groq (used by both LLM provider "groq" and TTS provider "groq")
GROQ_API_KEY=

# Auth
JWT_SECRET_KEY=change-me-in-production

# PostgreSQL (if using pgvector or postgres profile)
PG_PASSWORD=jarvis

# Voice WebRTC (only needed when running behind NAT / inside Docker)
WEBRTC_HOST_IP=127.0.0.1
WEBRTC_UDP_PORT_MIN=7880
WEBRTC_UDP_PORT_MAX=7889

# Mneme long-term memory (memory-as-a-service)
# Create a 'jarvis' agent + API key in Mneme, then set:
MNEME_ENABLED=true
MNEME_BASE_URL=http://host.docker.internal:8000   # or http://localhost:8000 if not in Docker
MNEME_API_KEY=
